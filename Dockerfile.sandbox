# Pre-built recommended sandbox image for MeepaGateway agents.
# Published to ghcr.io/bogpad/meepagateway-sandbox:<version>
#
# Contains common tools agents need: Python, Node.js, browser automation,
# CLI utilities. Users can layer additional packages on top.

FROM ubuntu:24.04

LABEL org.opencontainers.image.source="https://github.com/bogpad/meepagateway"
LABEL org.opencontainers.image.description="Pre-built sandbox image for MeepaGateway agents"

ENV DEBIAN_FRONTEND=noninteractive
# Disable Chrome's internal sandbox — unnecessary inside a container (already isolated)
# and Chrome refuses to start as root without this.
ENV CHROMIUM_FLAGS="--no-sandbox"
ENV PLAYWRIGHT_CHROMIUM_SANDBOX=0
# Store Playwright browsers in a shared location accessible by any UID
# (container may run as non-root via --user)
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright

# System packages
# Skip chromium-browser — it's a transitional snap package that pulls in snapd
# (compiled with old Go stdlib, triggers 35+ CVEs). Playwright installs its own Chromium below.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    jq \
    wget \
    unzip \
    openssh-client \
    sqlite3 \
    python3 \
    python3-venv \
    python3-pip \
    nodejs \
    npm \
    fonts-liberation \
    && apt-get purge -y --auto-remove snapd && rm -rf /var/lib/snapd \
    && rm -rf /var/lib/apt/lists/*

# Python packages — use --ignore-installed to shadow debian-packaged versions (pip can't uninstall them)
RUN pip3 install --no-cache-dir --break-system-packages --ignore-installed \
    Pillow setuptools wheel

# Global npm packages
RUN npm install -g typescript agent-browser@latest

# Install Playwright Chromium + all system deps into shared location
RUN npx playwright install --with-deps chromium \
    && chmod -R o+rX /opt/playwright

RUN mkdir -p /agent/workspace && chmod 777 /agent /agent/workspace
WORKDIR /agent
