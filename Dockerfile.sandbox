# Pre-built recommended sandbox image for MeepaGateway agents.
# Published to ghcr.io/bogpad/meepagateway-sandbox:<version>
#
# Contains common tools agents need: Python, Node.js, browser automation,
# CLI utilities. Users can layer additional packages on top.

FROM ubuntu:24.04

LABEL org.opencontainers.image.source="https://github.com/bogpad/meepagateway"
LABEL org.opencontainers.image.description="Pre-built sandbox image for MeepaGateway agents"

ENV DEBIAN_FRONTEND=noninteractive

# System packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    jq \
    wget \
    unzip \
    openssh-client \
    sqlite3 \
    python3 \
    python3-venv \
    python3-pip \
    nodejs \
    npm \
    chromium-browser \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Python packages
RUN pip3 install --no-cache-dir --break-system-packages Pillow

# Global npm packages
RUN npm install -g typescript agent-browser

# Install Playwright Chromium + all system deps
RUN npx playwright install --with-deps chromium

RUN mkdir -p /agent/workspace && chmod 777 /agent /agent/workspace
WORKDIR /agent
